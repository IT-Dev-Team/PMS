# DeepSeek API Configuration
# Get your free API key from: https://platform.deepseek.com/
NEXT_PUBLIC_DEEPSEEK_API_KEY=sk_live_your_api_key_here

BETTER_AUTH_UR=https://pms.eih.et
# Run the initialization
npm run db:init
# Microsoft OAuth Configuration (Optional for NextAuth)
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# Optional: Microsoft Azure AD Configuration
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret
# OAuth Credentials
# JWT Secret
JWT_SECRET=your-eih-super-secret-key-minimum-32-characters
